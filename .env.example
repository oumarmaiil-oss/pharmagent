# Clé API Claude (obligatoire) — https://console.anthropic.com/settings/keys
# Sur Render : Dashboard > service > Environment
ANTHROPIC_API_KEY="VOTRE_CLE_ANTHROPIC"

# Modèle optionnel (par défaut : claude-haiku-5-5)
# CLAUDE_MODEL="claude-haiku-5-5"

# Base Postgres (sinon fichier local dans DATA_DIR)
# DATABASE_URL="postgres://..."

# Coordonnées d'assistance — affichées sur la fiche d'installation et dans
# l'agent. Volontairement hors du dépôt : celui-ci est public.
# PHARMAGENT_SUPPORT_NOM="Dr. O. Sow"
# PHARMAGENT_SUPPORT_TEL="+221 ..."
# PHARMAGENT_SUPPORT_MAIL="..."

# Mots de passe (sinon générés aléatoirement au démarrage et affichés dans les logs)
# PHARMAGENT_OWNER_PASSWORD="..."
# PHARMAGENT_PHARMACY_DEFAULT_PASSWORD="..."
# PHARMAGENT_AUTH_SECRET="..."

# Conservation — plafonds PAR OFFICINE, jamais globaux : sinon la pharmacie
# la plus active efface l'historique des autres.
# PHARMAGENT_RETENTION_BONS_JOURS="365"
# PHARMAGENT_RETENTION_AUDIT_JOURS="730"
# PHARMAGENT_MAX_BONS_PAR_OFFICINE="2000"
# PHARMAGENT_MAX_AUDIT_PAR_OFFICINE="5000"

# Dossier des données si pas de DATABASE_URL
# DATA_DIR="./data"
