# GEMINI_API_KEY : obligatoire pour les appels à l'API Gemini (côté serveur uniquement).
# Sur Render : Dashboard > service > Environment.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL : optionnel, modèle Gemini utilisé (par défaut : gemini-4-argon).
# GEMINI_MODEL="gemini-4-argon"

# DATA_DIR : optionnel, dossier de persistance (base JSON + brouillons Excel).
# Sur Render le disque est éphémère : montez un Render Disk et pointez-le ici (ex. /var/data).
# DATA_DIR="/var/data"

# APP_URL : URL publique de l'application.
APP_URL="MY_APP_URL"
