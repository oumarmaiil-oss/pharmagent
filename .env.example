# Clé API Gemini (obligatoire) — https://aistudio.google.com/apikey
# Sur Render : Dashboard > service > Environment
GEMINI_API_KEY="VOTRE_CLE_GEMINI"

# Modèle Gemini optionnel (par défaut : gemini-2.0-flash)
# GEMINI_MODEL="gemini-2.0-flash"

# URL publique de l'application
APP_URL="http://localhost:3000"

# Mots de passe (sinon générés aléatoirement au démarrage et affichés dans les logs)
# PHARMAGENT_OWNER_PASSWORD="..."
# PHARMAGENT_PHARMACY_DEFAULT_PASSWORD="..."
# PHARMAGENT_AUTH_SECRET="..."

# Dossier de persistance données (sur Render : montez un Render Disk)
# DATA_DIR="/var/data"
