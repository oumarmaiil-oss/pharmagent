# Clé API Gemini (obligatoire pour l'extraction vision) : https://aistudio.google.com/apikey
GEMINI_API_KEY="VOTRE_CLE_GEMINI"

# URL publique de l'application (optionnel)
APP_URL="http://localhost:3000"

# Secret de signature des sessions (recommandé en production ; sinon généré et stocké dans data/)
# PHARMAGENT_AUTH_SECRET="une-longue-chaine-aleatoire"

# Mots de passe provisoires des NOUVEAUX comptes (sinon générés au démarrage et affichés dans les logs)
# PHARMAGENT_OWNER_PASSWORD="..."
# PHARMAGENT_PHARMACY_DEFAULT_PASSWORD="..."
